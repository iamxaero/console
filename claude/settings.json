{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "echo 'BLOCKING PRE-ANSWER PROTOCOL (user-enforced): (1) Skills live in ~/Documents/git/.agent/skills/ — match the question against the skill directories there; if any matches the topic, Read that SKILL.md BEFORE answering. (2) Label every claim: verified (file/line/log evidence) vs assumption — never present an assumption as fact. (3) If the message is a question — answer it first; no commands before the answer and the stated next actions.'",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/vk/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(argocd:*)",
      "Bash(docker:*)",
      "Bash(flux:*)",
      "Bash(gh:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(glab:*)",
      "Bash(helm:*)",
      "Bash(kubectl:*)",
      "Bash(mv:*)",
      "Bash(op:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(terraform:*)",
      "Bash(terragrunt:*)",
      "Bash(vault:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "theme": "auto"
}
